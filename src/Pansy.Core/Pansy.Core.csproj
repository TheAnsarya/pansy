<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Pansy Metadata Format Library</Title>
    <Description>Universal disassembly metadata format for retro gaming platforms</Description>
    <Authors>TheAnsarya</Authors>
    <PackageProjectUrl>https://github.com/TheAnsarya/pansy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheAnsarya/pansy</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>pansy-icon.png</PackageIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>

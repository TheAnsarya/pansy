<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Pansy.UI"
        mc:Ignorable="d"
        x:Class="Pansy.UI.InputDialog"
        x:DataType="vm:InputDialog"
        Width="400" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
		<TextBlock Grid.Row="0" Text="{Binding Label1}" FontWeight="SemiBold" Margin="0,0,0,4" />
		<TextBox Grid.Row="1" Text="{Binding Value1}" Watermark="Enter value..." Margin="0,0,0,12" />

		<TextBlock Grid.Row="2" Text="{Binding Label2}" FontWeight="SemiBold" Margin="0,0,0,4" />
		<TextBox Grid.Row="3" Text="{Binding Value2}" Watermark="Enter value..." AcceptsReturn="True" />

		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="OK" Click="OK_Click" Margin="0,0,8,0" Width="80" IsDefault="True" />
			<Button Content="Cancel" Click="Cancel_Click" Width="80" IsCancel="True" />
		</StackPanel>
	</Grid>
</Window>

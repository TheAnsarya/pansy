<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Pansy.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Pansy.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200" Height="800">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*">
		<!-- Menu Bar -->
		<Menu Grid.Row="0">
			<MenuItem Header="_File">
				<MenuItem Header="_Open..." Click="OpenFile_Click" HotKey="Ctrl+O" />
				<MenuItem Header="_Save" Click="SaveFile_Click" HotKey="Ctrl+S" IsEnabled="{Binding CanSave}" />
				<MenuItem Header="Save _As..." Click="SaveFileAs_Click" HotKey="Ctrl+Shift+S" IsEnabled="{Binding HasFileLoaded}" />
				<Separator />
				<MenuItem Header="E_xit" Click="Exit_Click" HotKey="Alt+F4" />
			</MenuItem>
			<MenuItem Header="_Edit">
				<MenuItem Header="Add _Symbol" Click="AddSymbol_Click" HotKey="Ctrl+Shift+S" IsEnabled="{Binding HasFileLoaded}" />
				<MenuItem Header="Add _Comment" Click="AddComment_Click" HotKey="Ctrl+Shift+C" IsEnabled="{Binding HasFileLoaded}" />
				<MenuItem Header="Add _Memory Region" Click="AddMemoryRegion_Click" HotKey="Ctrl+Shift+M" IsEnabled="{Binding HasFileLoaded}" />
				<Separator />
				<MenuItem Header="_Find..." Click="ShowSearch_Click" HotKey="Ctrl+F" IsEnabled="{Binding HasFileLoaded}" />
			</MenuItem>
			<MenuItem Header="_View">
				<MenuItem Header="_Symbols" />
				<MenuItem Header="_Comments" />
				<MenuItem Header="_Memory Regions" />
				<MenuItem Header="_Cross-References" />
			</MenuItem>
			<MenuItem Header="_Help">
				<MenuItem Header="_About..." />
			</MenuItem>
		</Menu>

		<!-- Main Content -->
		<TabControl Grid.Row="1" Margin="8">
			<!-- Overview Tab -->
			<TabItem Header="📋 Overview">
				<ScrollViewer>
					<StackPanel Margin="16" Spacing="16">
						<TextBlock Text="File Information" FontSize="18" FontWeight="Bold" />

						<Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="8,0">
							<TextBlock Grid.Row="0" Grid.Column="0" Text="File:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" />

							<TextBlock Grid.Row="1" Grid.Column="0" Text="Platform:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlatformName}" />

							<TextBlock Grid.Row="2" Grid.Column="0" Text="ROM Size:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RomSize}" />

							<TextBlock Grid.Row="3" Grid.Column="0" Text="ROM CRC32:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RomCrc}" />

							<TextBlock Grid.Row="4" Grid.Column="0" Text="File Version:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FileVersion}" />

							<TextBlock Grid.Row="5" Grid.Column="0" Text="Compressed:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding IsCompressed}" />
						</Grid>

						<TextBlock Text="Statistics" FontSize="18" FontWeight="Bold" Margin="0,16,0,0" />

						<Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8,0">
							<TextBlock Grid.Row="0" Grid.Column="0" Text="Symbols:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SymbolCount}" />

							<TextBlock Grid.Row="1" Grid.Column="0" Text="Comments:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommentCount}" />

							<TextBlock Grid.Row="2" Grid.Column="0" Text="Code Offsets:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CodeOffsetCount}" />

							<TextBlock Grid.Row="3" Grid.Column="0" Text="Data Offsets:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DataOffsetCount}" />

							<TextBlock Grid.Row="4" Grid.Column="0" Text="Jump Targets:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding JumpTargetCount}" />

							<TextBlock Grid.Row="5" Grid.Column="0" Text="Subroutines:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SubroutineCount}" />

							<TextBlock Grid.Row="6" Grid.Column="0" Text="Memory Regions:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MemoryRegionCount}" />

							<TextBlock Grid.Row="7" Grid.Column="0" Text="Cross-References:" FontWeight="SemiBold" />
							<TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CrossRefCount}" />
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- Symbols Tab -->
			<TabItem Header="🏷️ Symbols">
				<DockPanel>
					<!-- Toolbar -->
					<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
						<Button Content="➕ Add" Click="AddSymbol_Click" Margin="2" IsEnabled="{Binding HasFileLoaded}" />
						<Button Content="✏️ Edit" Click="EditSymbol_Click" Margin="2" IsEnabled="{Binding CanEditSymbol}" />
						<Button Content="🗑️ Delete" Click="DeleteSymbol_Click" Margin="2" IsEnabled="{Binding CanDeleteSymbol}" />
						<Separator Margin="8,0" />
						<TextBlock Text="🔍 Search:" VerticalAlignment="Center" Margin="4,0" />
						<TextBox Width="200" Text="{Binding SearchText}"
						         Watermark="Filter symbols..."
						         TextChanged="SearchSymbols_Changed"
						         ToolTip.Tip="Search modes:&#x0A;• Plain text: hello&#x0A;• Wildcard: *Main*&#x0A;• Regex: /^NMI_.*/&#x0A;• Case-sensitive: ~Handler" />
						<Button Content="✖️ Clear" Click="ClearSearch_Click" Margin="2" />
					</StackPanel>

					<!-- DataGrid -->
					<DataGrid ItemsSource="{Binding FilteredSymbols}"
					          SelectedItem="{Binding SelectedSymbol}"
					          IsReadOnly="False"
					          GridLinesVisibility="All"
					          AutoGenerateColumns="False"
					          Margin="8"
					          DoubleTapped="EditSymbol_Click">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120" />
							<DataGridTextColumn Header="Symbol Name" Binding="{Binding Name}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<!-- Comments Tab -->
			<TabItem Header="💬 Comments">
				<DockPanel>
					<!-- Toolbar -->
					<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
						<Button Content="➕ Add" Click="AddComment_Click" Margin="2" IsEnabled="{Binding HasFileLoaded}" />
						<Button Content="✏️ Edit" Click="EditComment_Click" Margin="2" IsEnabled="{Binding CanEditComment}" />
						<Button Content="🗑️ Delete" Click="DeleteComment_Click" Margin="2" IsEnabled="{Binding CanDeleteComment}" />
						<Separator Margin="8,0" />
						<TextBlock Text="🔍 Search:" VerticalAlignment="Center" Margin="4,0" />
						<TextBox Width="200" Text="{Binding SearchText}"
						         Watermark="Filter comments..."
						         TextChanged="SearchSymbols_Changed"
						         ToolTip.Tip="Search modes:&#x0A;• Plain text: hello&#x0A;• Wildcard: *Main*&#x0A;• Regex: /^NMI_.*/&#x0A;• Case-sensitive: ~Handler" />
						<Button Content="✖️ Clear" Click="ClearSearch_Click" Margin="2" />
					</StackPanel>

					<!-- DataGrid -->
					<DataGrid ItemsSource="{Binding FilteredComments}"
					          SelectedItem="{Binding SelectedComment}"
					          IsReadOnly="False"
					          GridLinesVisibility="All"
					          AutoGenerateColumns="False"
					          Margin="8"
					          DoubleTapped="EditComment_Click">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120" />
							<DataGridTextColumn Header="Comment" Binding="{Binding Text}" Width="*" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<!-- Memory Regions Tab -->
			<TabItem Header="🗺️ Memory Regions">
				<DockPanel>
					<!-- Toolbar -->
					<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
						<Button Content="➕ Add" Click="AddMemoryRegion_Click" Margin="2" IsEnabled="{Binding HasFileLoaded}" />
						<Button Content="✏️ Edit" Click="EditMemoryRegion_Click" Margin="2" IsEnabled="{Binding CanEditMemoryRegion}" />
						<Button Content="🗑️ Delete" Click="DeleteMemoryRegion_Click" Margin="2" IsEnabled="{Binding CanDeleteMemoryRegion}" />
					</StackPanel>

					<!-- DataGrid -->
					<DataGrid ItemsSource="{Binding MemoryRegions}"
					          SelectedItem="{Binding SelectedMemoryRegion}"
					          IsReadOnly="False"
					          GridLinesVisibility="All"
					          AutoGenerateColumns="False"
					          Margin="8"
					          DoubleTapped="EditMemoryRegion_Click">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
							<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
							<DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="100" />
							<DataGridTextColumn Header="End" Binding="{Binding End}" Width="100" />
							<DataGridTextColumn Header="Bank" Binding="{Binding Bank}" Width="80" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<!-- Cross-References Tab -->
			<TabItem Header="🔗 Cross-References">
				<DockPanel>
					<!-- Toolbar -->
					<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
						<Button Content="🗑️ Delete" Click="DeleteCrossRef_Click" Margin="2" IsEnabled="{Binding CanDeleteCrossRef}" />
						<Separator Margin="8,0" />

						<TextBlock Text="Type:" VerticalAlignment="Center" Margin="4,0" />
						<ComboBox SelectedItem="{Binding XrefFilterType}" Width="120" Margin="2" SelectionChanged="XrefTypeFilter_Changed">
							<ComboBoxItem Content="All" IsSelected="True" />
							<ComboBoxItem Content="Jsr" />
							<ComboBoxItem Content="Jmp" />
							<ComboBoxItem Content="Branch" />
							<ComboBoxItem Content="Read" />
							<ComboBoxItem Content="Write" />
							<ComboBoxItem Content="DataRef" />
						</ComboBox>

						<TextBlock Text="Address:" VerticalAlignment="Center" Margin="8,0,4,0" />
						<TextBox Width="120" Text="{Binding XrefFilterAddress}"
						         Watermark="$8000"
						         TextChanged="XrefAddressFilter_Changed"
						         ToolTip.Tip="Filter by From or To address" />
						<Button Content="✖️ Clear" Click="ClearXrefFilter_Click" Margin="2" />
					</StackPanel>

					<!-- DataGrid -->
					<DataGrid ItemsSource="{Binding FilteredCrossReferences}"
					          SelectedItem="{Binding SelectedCrossRef}"
					          IsReadOnly="True"
					          GridLinesVisibility="All"
					          AutoGenerateColumns="False"
					          Margin="8">
						<DataGrid.Columns>
							<DataGridTextColumn Header="From" Binding="{Binding From}" Width="120" />
							<DataGridTextColumn Header="To" Binding="{Binding To}" Width="120" />
							<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>

			<!-- Call Graph Tab -->
			<TabItem Header="📊 Call Graph">
				<DockPanel>
					<!-- Toolbar -->
					<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
						<Button Content="🔄 Refresh" Click="RefreshGraph_Click" Margin="2" IsEnabled="{Binding HasFileLoaded}" />
						<Separator Margin="8,0" />
						<TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="4,0" />
						<Slider x:Name="GraphZoomSlider" Width="150" Minimum="0.25" Maximum="2.0" Value="1.0"
						        TickFrequency="0.25" IsSnapToTickEnabled="True"
						        ValueChanged="GraphZoom_Changed" />
						<TextBlock Text="{Binding ElementName=GraphZoomSlider, Path=Value, StringFormat='{}{0:P0}'}"
						           VerticalAlignment="Center" Margin="4,0" Width="50" />
						<Separator Margin="8,0" />
						<Button Content="📷 Export PNG" Click="ExportGraphPng_Click" Margin="2" IsEnabled="{Binding HasFileLoaded}" />
						<Button Content="📄 Export DOT" Click="ExportGraphDot_Click" Margin="2" IsEnabled="{Binding HasFileLoaded}" />
					</StackPanel>

					<!-- Graph Canvas -->
					<Border BorderBrush="Gray" BorderThickness="1" Margin="8">
						<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
							<Canvas x:Name="GraphCanvas" Background="White" Width="2000" Height="1500">
								<!-- Graph nodes and edges are drawn programmatically -->
							</Canvas>
						</ScrollViewer>
					</Border>
				</DockPanel>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
